# Discord OAuth Configuration
# Get these from https://discord.com/developers/applications
#
# All four vars must be present (even if blank) or `npm run dev` / `npm run
# build` fail — `$env/static/private` errors on imports it can't resolve.
# For local work you don't need a real Discord app: fill these with
# placeholders and use the DEV LOGIN panel on the welcome screen instead.

DISCORD_CLIENT_ID=your_client_id_here
DISCORD_CLIENT_SECRET=your_client_secret_here
DISCORD_REDIRECT_URI=http://localhost:4201/api/auth/callback

# Comma-separated Discord user IDs granted the super-admin gate (/superadmin,
# /api/game/settings, the admin WebSocket). Leave blank in dev — the DEV LOGIN
# "super admin" checkbox grants it without needing a real Discord ID.
SUPER_ADMIN_DISCORD_IDS=
